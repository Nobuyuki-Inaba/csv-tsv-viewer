# Development tools and config
.vscode/**
.github/**
.claude/**
.gitignore
.gitattributes
CLAUDE.md
PLAN.md

# TypeScript source, tests and fixtures
src/**
test/**
samples/**
scripts/**

# Ship the rendered icon only — the SVG source and the README screenshot
# (served from GitHub) do not need to travel in the package
images/*.svg
images/screenshot.png

# Only README.md is rendered by the Marketplace; the translation is linked
# from it and lives on GitHub
README.ja.md
**/*.ts
**/tsconfig*.json
build.mjs
vitest.config.ts

# Build artifacts — ship only the bundles
**/*.map

# Node modules (bundled into dist/ by esbuild)
node_modules/**

# Package management
package-lock.json
